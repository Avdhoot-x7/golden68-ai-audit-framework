% neurips_2026.sty - NeurIPS 2026 Style File
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026/01/01 NeurIPS 2026 submission/camera-ready style file]

\DeclareOption{final}{\gdef\@neuripsfinal{1}}
\DeclareOption{nonatbib}{\gdef\@nonatbib{1}}
\ProcessOptions\relax

% Page Geometry (NeurIPS standard 8.5 x 11 inch with 1 in margins)
\usepackage[verbose=true,letterpaper]{geometry}
\geometry{
  textheight=9.0in,
  textwidth=5.5in,
  top=1.0in,
  headheight=12pt,
  headsep=25pt,
  footskip=30pt
}

% Fonts
\renewcommand{\rmdefault}{ptm}
\renewcommand{\sfdefault}{phv}

% Line spacing
\renewcommand{\baselinestretch}{1.0}

% Section formatting
\usepackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}

% Headings & Footers
\pagestyle{plain}

\endinput
